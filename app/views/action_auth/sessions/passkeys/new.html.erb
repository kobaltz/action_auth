<%= render "action_auth/shared/flash" %>

<%= action_auth_webauthn_tags %>
<%= tag.meta name: "passkey_auth_url", content: sessions_passkeys_url %>

<h2 class="action-auth--text-center">Use a passkey to sign in</h2>

<%= render "action_auth/shared/webauthn_error" %>

<%= content_tag :div,
  id: "webauthn_credential_form",
  data: {
    controller: "credential-authenticator",
    "credential-authenticator-options-value": @options
  },
  class: "action-auth--text-center" do %>

  <div class="mb-3 action-auth--text-center">
    You must use a passkey, not a hardware key, to sign in.
    An account with a matching passkey is required.
  </div>
<% end %>

<div class="action-auth--text-center">
  <%= link_to "Cancel", sign_in_path %>
</div>
