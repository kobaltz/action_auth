<%= render "action_auth/shared/flash" %>

<h1>Devices &amp; Sessions</h1>
<small><%= link_to "back to app", after_sign_in_path %></small>

<%= render "action_auth/sessions/sessions", sessions: @sessions %>

<% if ActionAuth.configuration.webauthn_enabled? %>
  <%= render "action_auth/sessions/security_keys" %>
<% end %>

<% if ActionAuth.configuration.oauth_enabled? && ActionAuth::ConnectedAccount.table_exists? %>
  <%= render "action_auth/sessions/connected_accounts" %>
<% end %>

<%= render "action_auth/sessions/account" %>
