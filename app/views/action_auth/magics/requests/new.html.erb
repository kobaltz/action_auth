<%= render "action_auth/shared/flash" %>

<h1>Request Magic Link</h1>

<%= form_with(url: magics_requests_path) do |form| %>
  <div class="mb-3">
    <%= form.label :email, style: "display: block" %>
    <%= form.email_field :email, value: params[:email], required: true, autofocus: true, autocomplete: "email" %>
  </div>

  <div class="mb-3">
    <%= form.submit "Request Magic Link", class: "btn btn-primary" %>
  </div>
<% end %>

<%= render "action_auth/shared/links" %>
