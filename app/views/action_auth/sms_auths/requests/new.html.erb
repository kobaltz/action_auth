<%= render "action_auth/shared/flash" %>

<h1>Request SMS Code</h1>

<%= form_with(url: sms_auths_requests_path) do |form| %>
  <div class="mb-3">
    <%= form.label :phone_number, style: "display: block" %>
    <%= form.telephone_field :phone_number, value: params[:phone_number], required: true, autofocus: true, autocomplete: "tel" %>
  </div>

  <div class="mb-3">
    <%= form.submit "Request SMS Code", class: "btn btn-primary" %>
  </div>
<% end %>

<%= render "action_auth/shared/links" %>
