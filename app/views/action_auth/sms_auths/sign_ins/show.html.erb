<%= render "action_auth/shared/flash" %>

<h1>Verify SMS Code</h1>

<%= form_with(url: sms_auths_sign_ins_path) do |form| %>
  <div class="mb-3">
    <%= form.label :sms_code, style: "display: block" %>
    <%= form.text_field :sms_code, required: true, autofocus: true, autocomplete: "one-time-code", inputmode: "numeric" %>
  </div>

  <div class="mb-3">
    <%= form.submit "Sign In", class: "btn btn-primary" %>
  </div>
<% end %>

<div>
  <%= link_to "Send a new code", new_sms_auths_requests_path %>
</div>
