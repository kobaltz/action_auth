<%= render "action_auth/shared/flash" %>

<h1>Forgot your password?</h1>

<%= form_with(url: identity_password_reset_path) do |form| %>
  <div class="mb-3">
    <%= form.label :email, style: "display: block" %>
    <%= form.email_field :email, required: true, autofocus: true, autocomplete: "email" %>
  </div>

  <div class="mb-3">
    <%= form.submit "Send password reset email", class: "btn btn-primary" %>
  </div>
<% end %>

<%= render "action_auth/shared/links" %>
