<%= render "action_auth/shared/flash" %>

<% if user_signed_in? %>
  <h1>Change Your Email</h1>

  <%= form_with(url: identity_email_path, method: :patch) do |form| %>
    <%= render "action_auth/shared/errors", record: @user %>

    <div class="mb-3">
      <%= form.label :email, "New email", style: "display: block" %>
      <%= form.email_field :email, value: params[:email], required: true, autofocus: true, autocomplete: "email" %>
    </div>

    <div class="mb-3">
      <%= form.label :password_challenge, "Current password", style: "display: block" %>
      <%= form.password_field :password_challenge, required: true, autocomplete: "current-password" %>
    </div>

    <div class="mb-3">
      <%= form.submit "Save changes", class: "btn btn-primary" %>
    </div>
  <% end %>

  <% unless current_user.verified? %>
    <div class="mb-3">
      <p><%= current_user.email %> hasn't been verified yet.</p>
      <%= button_to "Resend verification email", identity_email_verification_path, params: { email: current_user.email }, class: "btn btn-primary" %>
    </div>
  <% end %>

  <div>
    <%= link_to "Back", sessions_path %>
  </div>
<% else %>
  <h1>Verify Your Email</h1>

  <%= form_with(url: identity_email_verification_path) do |form| %>
    <div class="mb-3">
      <%= form.label :email, style: "display: block" %>
      <%= form.email_field :email, required: true, autofocus: true, autocomplete: "email" %>
    </div>

    <div class="mb-3">
      <%= form.submit "Send verification email", class: "btn btn-primary" %>
    </div>
  <% end %>

  <%= render "action_auth/shared/links" %>
<% end %>
