<!DOCTYPE html>
<html>
<head>
  <title><%= content_for(:title).presence || "Action Auth" %></title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= stylesheet_link_tag "action_auth/application", media: "all" %>
  <%= action_auth_webauthn_tags if action_auth_webauthn_screen? %>
</head>
<body class="bg-light">
  <div class="<%= defined?(@action_auth_wide) ? 'container-fluid' : 'container' %> bg-white border pb-3">
    <%= yield %>
  </div>
  <div class="action-auth--text-center">
    <%= yield(:cancel_path) %>
  </div>
</body>
</html>
